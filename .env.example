# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Both values are public. Never put the service_role / secret key or DB password here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Development only: 1 = don't stop at the consent screen when the signed-in user has no consent records.
# No consent is recorded, a warning banner stays visible, and production builds ignore it.
EXPO_PUBLIC_DEV_SKIP_CONSENT_GATE=0
