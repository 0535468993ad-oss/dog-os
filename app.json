{
  "expo": {
    "name": "Dog OS",
    "slug": "dog-os",
    "version": "1.0.0",
    "scheme": "dogos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "lang": "he"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080A0F",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#00E5FF",
                "dark": "#00E5FF"
              },
              "colorControlActivated": {
                "light": "#00E5FF",
                "dark": "#00E5FF"
              },
              "windowBackground": {
                "light": "#121620",
                "dark": "#121620"
              },
              "textColor": {
                "light": "#F9FAFB",
                "dark": "#F9FAFB"
              },
              "textColorPrimary": {
                "light": "#F9FAFB",
                "dark": "#F9FAFB"
              },
              "textColorSecondary": {
                "light": "#9CA3AF",
                "dark": "#9CA3AF"
              },
              "textColorPrimaryInverse": {
                "light": "#080A0F",
                "dark": "#080A0F"
              }
            }
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dog OS צריכה גישה לתמונות כדי להוסיף תמונת פרופיל לכלב.",
          "cameraPermission": "Dog OS צריכה גישה למצלמה כדי לצלם את הכלב."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#080A0F"
  }
}
